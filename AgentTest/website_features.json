{
    "website_info": {
        "name": "Pet Social Platform",
        "base_url": "http://localhost:3000",
        "description": "A comprehensive pet management and social platform with health tracking, social features, and AI assistance"
    },
    "features": {
        "auth": {
            "home": {
                "path": "/",
                "description": "Landing page - redirects to /main if authenticated",
                "elements": {
                    "login_link": {
                        "selector": ".login-link",
                        "type": "link",
                        "description": "Link to login page"
                    },
                    "register_link": {
                        "selector": ".register-link",
                        "type": "link",
                        "description": "Link to registration page"
                    }
                }
            },
            "login": {
                "path": "/login",
                "description": "User login page",
                "elements": {
                    "username_input": {
                        "selector": ".input",
                        "type": "input",
                        "description": "Username or email input field"
                    },
                    "password_input": {
                        "selector": ".input",
                        "type": "input",
                        "description": "Password input field"
                    },
                    "login_button": {
                        "selector": ".login-button",
                        "type": "button",
                        "description": "Login submit button"
                    },
                    "register_link": {
                        "selector": ".register-link",
                        "type": "link",
                        "description": "Link to registration"
                    }
                }
            },
            "register": {
                "path": "/register",
                "description": "Multi-step user registration",
                "elements": {
                    "account_input": {
                        "selector": ".accountInput .input",
                        "type": "input",
                        "description": "Account username input (step 1)"
                    },
                    "email_input": {
                        "selector": ".accountInput .input",
                        "type": "input",
                        "description": "Email input (step 2)"
                    },
                    "password_input": {
                        "selector": ".passwordInputWrapper .input",
                        "type": "input",
                        "description": "Password input (step 3)"
                    },
                    "confirm_password_input": {
                        "selector": ".accountInput .input",
                        "type": "input",
                        "description": "Confirm password input"
                    },
                    "next_button": {
                        "selector": ".nextStepButton",
                        "type": "button",
                        "description": "Next step button"
                    },
                    "back_button": {
                        "selector": ".backButton",
                        "type": "button",
                        "description": "Previous step button"
                    },
                    "register_button": {
                        "selector": ".registerButton",
                        "type": "button",
                        "description": "Final registration button"
                    }
                }
            }
        },
        "main": {
            "main_page": {
                "path": "/main",
                "description": "Main dashboard with AI navigator and daily schedule",
