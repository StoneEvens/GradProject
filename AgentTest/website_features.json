    "workflows": {
        "authentication": {
            "register_workflow": {
                "description": "Complete user registration process",
                "steps": [
                    {
                        "action": "navigate",
                        "path": "/register"
                    },
                    {
                        "action": "fill",
                        "element": "account_input",
                        "description": "Enter username"
                    },
                    {
                        "action": "click",
                        "element": "next_button"
                    },
                    {
                        "action": "fill",
                        "element": "email_input",
                        "description": "Enter email"
                    },
                    {
                        "action": "click",
                        "element": "next_button"
                    },
                    {
                        "action": "fill",
                        "element": "password_input",
                        "description": "Enter password"
                    },
                    {
                        "action": "fill",
                        "element": "confirm_password_input",
                        "description": "Confirm password"
                    },
                    {
                        "action": "click",
                        "element": "register_button"
                    }
                ]
            },
            "login_workflow": {
                "description": "User login process",
                "steps": [
                    {
                        "action": "navigate",
                        "path": "/login"
                    },
                    {
                        "action": "fill",
                        "element": "username_input",
                        "description": "Enter credentials"
                    },
                    {
                        "action": "click",
                        "element": "login_button"
                    }
                ]
            }
        },
        "pet_management": {
            "add_pet_workflow": {
                "description": "Add a new pet",
                "steps": [
                    {
                        "action": "navigate",
                        "path": "/pet"
                    },
                    {
                        "action": "click",
                        "element": "add_first_pet_button"
                    },
                    {
                        "action": "fill_form",
                        "elements": ["name_input", "breed_select", "photo_upload"]
                    },
                    {
                        "action": "click",
                        "element": "submit_button"
                    }
                ]
            },
            "create_disease_archive_workflow": {
                "description": "Create disease archive for pet",
                "steps": [
                    {
                        "action": "navigate",
                        "path": "/pet/:petId/disease-archive"
                    },
                    {
                        "action": "click",
                        "element": "create_button"
                    },
                    {
                        "action": "fill_form",
                        "description": "Fill archive basic info"
                    },
                    {
                        "action": "navigate",
                        "path": "/pet/:petId/disease-archive/edit-content"
                    },
                    {
                        "action": "edit",
                        "element": "content_editor"
                    },
                    {
                        "action": "navigate",
                        "path": "/pet/:petId/disease-archive/preview"
                    },
                    {
                        "action": "click",
                        "element": "publish_button"
                    }
                ]
            }
        },
        "health_tracking": {
            "upload_health_report_workflow": {
                "description": "Upload and create health report",
                "steps": [
                    {
                        "action": "navigate",
                        "path": "/pet/:petId/health-reports"
                    },
                    {
                        "action": "click",
                        "element": "upload_button"
                    },
                    {
                        "action": "upload",
                        "element": "file_upload"
                    },
                    {
                        "action": "click",
                        "element": "submit_button"
                    }
                ]
            },
            "use_calculator_workflow": {
                "description": "Use health calculator for blood test results",
                "steps": [
                    {
                        "action": "navigate",
                        "path": "/calculator"
                    },
                    {
                        "action": "fill_form",
                        "element": "step1"
                    },
                    {
                        "action": "fill_form",
                        "element": "step2"
                    },
                    {
                        "action": "view_results",
                        "element": "step3"
                    }
                ]
            },
            "create_abnormal_post_workflow": {
                "description": "Report abnormal pet condition",
                "steps": [
                    {
                        "action": "click",
                        "element": "bottom_nav.post"
                    },
                    {
                        "action": "click",
                        "element": "abnormal_record_option"
                    },
                    {
                        "action": "fill_form",
                        "element": "abnormal_form"
                    },
                    {
                        "action": "submit"
                    }
                ]
            }
        },
        "social_interaction": {
            "create_post_workflow": {
                "description": "Create and publish daily post",
                "steps": [
                    {
                        "action": "navigate",
                        "path": "/create-post"
                    },
                    {
                        "action": "upload",
                        "element": "image_upload"
                    },
                    {
                        "action": "fill",
                        "element": "description_input"
                    },
                    {
                        "action": "fill",
                        "element": "hashtag_input"
                    },
                    {
                        "action": "click",
                        "element": "preview_button"
                    },
                    {
                        "action": "navigate",
                        "path": "/create-post-preview"
                    },
                    {
                        "action": "click",
                        "element": "publish_button"
                    }
                ]
            },
            "search_and_view_posts_workflow": {
                "description": "Search for posts",
                "steps": [
                    {
                        "action": "navigate",
                        "path": "/search-posts"
                    },
                    {
                        "action": "fill",
                        "element": "search_input"
                    },
                    {
                        "action": "view",
                        "element": "results"
                    }
                ]
            },
            "follow_user_workflow": {
                "description": "Follow another user",
                "steps": [
                    {
                        "action": "navigate",
                        "path": "/user/:userAccount"
                    },
                    {
                        "action": "click",
                        "element": "follow_button"
                    }
                ]
            }
        },
        "feed_database": {
            "search_feed_workflow": {
                "description": "Search and review pet food",
                "steps": [
                    {
                        "action": "navigate",
                        "path": "/feeds"
                    },
                    {
                        "action": "fill",
                        "element": "search"
                    },
                    {
                        "action": "click",
                        "element": "feed_list_item"
                    },
                    {
                        "action": "navigate",
                        "path": "/feeds/:id"
                    },
                    {
                        "action": "click",
                        "element": "review_button"
                    }
                ]
            }
        },
        "interactive_city": {
            "explore_city_workflow": {
                "description": "Explore interactive city and checkpoints",
                "steps": [
                    {
                        "action": "navigate",
                        "path": "/interactive-city"
                    },
                    {
                        "action": "interact",
                        "element": "map_canvas"
                    },
                    {
                        "action": "click",
                        "element": "checkpoint"
                    },
                    {
                        "action": "navigate",
                        "path": "/checkpoint/:id"
                    }
                ]
            }
        }
    }
}